# Chat backend (Fastify + Socket.IO)
# Example: https://chat-backend.onrender.com
VITE_BACKEND_URL=

# Optional: mediasoup SFU media server (mediasoup + Socket.IO)
# Group calls use a P2P mesh by default and do not need this.
# Example: https://media.example.com
# Must be HTTPS/WSS when the web app is served over HTTPS.
VITE_MEDIA_SERVER_URL=
